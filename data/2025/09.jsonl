{"schemaVersion":1,"id":"CVE-2025-4953","state":"PUBLISHED","summary":"A flaw was found in Podman. In a Containerfile or Podman, data written to RUN --mount=type=bind mounts during the podman build is not discarded. This issue can lead to files created within the container appearing in t…","description":"A flaw was found in Podman. In a Containerfile or Podman, data written to RUN --mount=type=bind mounts during the podman build is not discarded. This issue can lead to files created within the container appearing in the temporary build context directory on the host, leaving the created files accessible.","published":"2025-09-16T14:54:50.045Z","lastModified":"2026-09-01T11:51:15.781Z","withdrawn":null,"severity":{"overall":"HIGH","cvss":7.4},"cvss":{"v2":null,"v3_0":null,"v3_1":{"vectorString":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:N","baseScore":7.4,"baseSeverity":"HIGH","exploitabilityScore":null,"impactScore":null,"source":"cve.org"},"v4_0":null},"cwe":[{"cweId":"CWE-378","name":"Creation of Temporary File With Insecure Permissions","source":"cve.org"}],"affected":[{"vendor":"Unknown","product":"Unknown","cpe":null,"versions":[{"version":null,"status":"affected","versionEndExcluding":"*","versionEndIncluding":null}],"platforms":[]},{"vendor":"Red Hat","product":"Red Hat Enterprise Linux 8","cpe":"cpe:/a:redhat:enterprise_linux:8::appstream","versions":[{"version":"8100020250911075811.afee755d","status":"unaffected","versionEndExcluding":"*","versionEndIncluding":null}],"platforms":[]},{"vendor":"Red Hat","product":"Red Hat OpenShift Container Platform 4.12","cpe":"cpe:/a:redhat:openshift:4.12::el8","versions":[{"version":"3:4.2.0-15.rhaos4.12.el9","status":"unaffected","versionEndExcluding":"*","versionEndIncluding":null}],"platforms":[]},{"vendor":"Red Hat","product":"Red Hat OpenShift Container Platform 4.12","cpe":"cpe:/a:redhat:openshift:4.12::el8","versions":[{"version":"412.86.202601061735-0","status":"unaffected","versionEndExcluding":"*","versionEndIn