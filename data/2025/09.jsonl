{"schemaVersion":1,"id":"CVE-2009-20007","state":"PUBLISHED","summary":"Talkative IRC v0.4.4.16 is vulnerable to a stack-based buffer overflow when processing specially crafted response strings sent to a connected client. An attacker can exploit this flaw by sending an overly long message…","description":"Talkative IRC v0.4.4.16 is vulnerable to a stack-based buffer overflow when processing specially crafted response strings sent to a connected client. An attacker can exploit this flaw by sending an overly long message that overflows a fixed-length buffer, potentially leading to arbitrary code execution in the context of the vulnerable process. This vulnerability is exploitable remotely and does not require authentication.","published":"2025-09-16T14:34:39.071Z","lastModified":"2026-05-15T11:13:16.716Z","withdrawn":null,"severity":{"overall":"CRITICAL","cvss":9.3},"cvss":{"v2":null,"v3_0":null,"v3_1":null,"v4_0":{"vectorString":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N","baseScore":9.3,"baseSeverity":"CRITICAL","exploitabilityScore":null,"impactScore":null,"source":"cve.org"}},"cwe":[{"cweId":"CWE-121","name":"CWE-121 Stack-based Buffer Overflow","source":"cve.org"}],"affected":[{"vendor":"Talkative","product":"Talkative IRC","cpe":null,"versions":[{"version":null,"status":"affected","versionEndExcluding":null,"versionEndIncluding":"0.4.4.16"}],"platforms":[]}],"configurations":[],"references":[{"url":"https://raw.githubusercontent.com/rapid7/metasploit-framework/master/modules/exploits/windows/misc/talkative_response.rb","source":"cve.org","tags":["exploit"]},{"url":"https://www.exploit-db.com/exploits/8227","source":"cve.org","tags":["exploit"]},{"url":"https://www.exploit-db.com/exploits/16459","source":"cve.org","tags":["exploit"]},{"url":"https://www.zeroscience.mk/en/vulnerabilities/ZSL-2009-4909.php","source":"cve.org","tags":["technical-description","exploit"]},{"url":"https://web.archive.org/web/20090116203306/http://www.talkative-irc