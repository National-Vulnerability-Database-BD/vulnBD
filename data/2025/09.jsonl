{"schemaVersion":1,"id":"CVE-2025-8277","state":"PUBLISHED","summary":"A flaw was found in libssh's handling of key exchange (KEX) processes when a client repeatedly sends incorrect KEX guesses. The library fails to free memory during these rekey operations, which can gradually exhaust s…","description":"A flaw was found in libssh's handling of key exchange (KEX) processes when a client repeatedly sends incorrect KEX guesses. The library fails to free memory during these rekey operations, which can gradually exhaust system memory. This issue can lead to crashes on the client side, particularly when using libgcrypt, which impacts application stability and availability.","published":"2025-09-09T11:55:39.036Z","lastModified":"2026-09-01T12:08:29.005Z","withdrawn":null,"severity":{"overall":"LOW","cvss":3.1},"cvss":{"v2":null,"v3_0":null,"v3_1":{"vectorString":"CVSS:3.1/AV:N/AC:H/PR:L/UI:N/S:U/C:N/I:N/A:L","baseScore":3.1,"baseSeverity":"LOW","exploitabilityScore":null,"impactScore":null,"source":"cve.org"},"v4_0":null},"cwe":[{"cweId":"CWE-401","name":"Missing Release of Memory after Effective Lifetime","source":"cve.org"}],"affected":[{"vendor":"Unknown","product":"Unknown","cpe":null,"versions":[{"version":"0.6.0","status":"affected","versionEndExcluding":"0.11.3","versionEndIncluding":null}],"platforms":[]},{"vendor":"Red Hat","product":"Red Hat Enterprise Linux 9","cpe":"cpe:/a:redhat:enterprise_linux:9::appstream","versions":[{"version":"0:0.10.4-18.el9","status":"unaffected","versionEndExcluding":"*","versionEndIncluding":null}],"platforms":[]},{"vendor":"Red Hat","product":"Red Hat Enterprise Linux 9","cpe":"cpe:/a:redhat:enterprise_linux:9::appstream","versions":[{"version":"0:0.10.4-18.el9","status":"unaffected","versionEndExcluding":"*","versionEndIncluding":null}],"platforms":[]},{"vendor":"Red Hat","product":"Red Hat Enterprise Linux 10","cpe":"cpe:/o:redhat:enterprise_linux:10","versions":[],"platforms":[]},{"vendor":"Red Hat","product":"Red Hat Enterprise