{"schemaVersion":1,"id":"CVE-2019-25222","state":"PUBLISHED","summary":"The Thumbnail carousel slider plugin for WordPress is vulnerable to SQL Injection via the 'id' parameter in all versions up to, and including, 1.0.4 due to insufficient escaping on the user supplied parameter and lack…","description":"The Thumbnail carousel slider plugin for WordPress is vulnerable to SQL Injection via the 'id' parameter in all versions up to, and including, 1.0.4 due to insufficient escaping on the user supplied parameter and lack of sufficient preparation on the existing SQL query.  This makes it possible for unauthenticated attackers to append additional SQL queries into already existing queries that can be used to extract sensitive information from the database.","published":"2025-03-15T06:40:02.532Z","lastModified":"2026-04-08T17:33:26.391Z","withdrawn":null,"severity":{"overall":"MEDIUM","cvss":4.9},"cvss":{"v2":null,"v3_0":null,"v3_1":{"vectorString":"CVSS:3.1/AV:N/AC:L/PR:H/UI:N/S:U/C:H/I:N/A:N","baseScore":4.9,"baseSeverity":"MEDIUM","exploitabilityScore":null,"impactScore":null,"source":"cve.org"},"v4_0":null},"cwe":[{"cweId":"CWE-89","name":"CWE-89 Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')","source":"cve.org"}],"affected":[{"vendor":"nik00726","product":"Thumbnail carousel slider","cpe":null,"versions":[{"version":null,"status":"affected","versionEndExcluding":null,"versionEndIncluding":"1.0.4"}],"platforms":[]}],"configurations":[],"references":[{"url":"https://www.wordfence.com/threat-intel/vulnerabilities/id/f6023483-3fa5-4b85-9422-7d395abcfbd8?source=cve","source":"cve.org","tags":[]},{"url":"https://wordpress.org/plugins/wp-responsive-thumbnail-slider","source":"cve.org","tags":[]},{"url":"https://plugins.trac.wordpress.org/browser/wp-responsive-thumbnail-slider/tags/1.0.4/wp-responsive-images-thumbnail-slider.php#L1326","source":"cve.org","tags":[]},{"url":"https://plugins.trac.wordpress.org/browser/wp-responsive-thumbn