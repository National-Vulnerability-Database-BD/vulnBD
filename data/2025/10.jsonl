{"schemaVersion":1,"id":"CVE-2025-9640","state":"PUBLISHED","summary":"A flaw was found in Samba, in the vfs_streams_xattr module, where uninitialized heap memory could be written into alternate data streams. This allows an authenticated user to read residual memory content that may incl…","description":"A flaw was found in Samba, in the vfs_streams_xattr module, where uninitialized heap memory could be written into alternate data streams. This allows an authenticated user to read residual memory content that may include sensitive data, resulting in an information disclosure vulnerability.","published":"2025-10-15T12:47:29.871Z","lastModified":"2026-09-01T12:08:39.850Z","withdrawn":null,"severity":{"overall":"MEDIUM","cvss":4.3},"cvss":{"v2":null,"v3_0":null,"v3_1":{"vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:L/I:N/A:N","baseScore":4.3,"baseSeverity":"MEDIUM","exploitabilityScore":null,"impactScore":null,"source":"cve.org"},"v4_0":null},"cwe":[{"cweId":"CWE-908","name":"Use of Uninitialized Resource","source":"cve.org"}],"affected":[{"vendor":"Unknown","product":"Unknown","cpe":null,"versions":[{"version":null,"status":"affected","versionEndExcluding":"4.21.9","versionEndIncluding":null},{"version":"4.22.0","status":"affected","versionEndExcluding":"4.21.5","versionEndIncluding":null},{"version":"4.23.0","status":"affected","versionEndExcluding":"4.23.2","versionEndIncluding":null}],"platforms":[]},{"vendor":"Red Hat","product":"Red Hat Enterprise Linux 10","cpe":"cpe:/o:redhat:enterprise_linux:10","versions":[],"platforms":[]},{"vendor":"Red Hat","product":"Red Hat Enterprise Linux 6","cpe":"cpe:/o:redhat:enterprise_linux:6","versions":[],"platforms":[]},{"vendor":"Red Hat","product":"Red Hat Enterprise Linux 6","cpe":"cpe:/o:redhat:enterprise_linux:6","versions":[],"platforms":[]},{"vendor":"Red Hat","product":"Red Hat Enterprise Linux 7","cpe":"cpe:/o:redhat:enterprise_linux:7","versions":[],"platforms":[]},{"vendor":"Red Hat","product":"Red Hat Enterprise