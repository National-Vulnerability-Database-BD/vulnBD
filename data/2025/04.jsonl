{"schemaVersion":1,"id":"CVE-2019-25223","state":"PUBLISHED","summary":"The Team Circle Image Slider With Lightbox plugin for WordPress is vulnerable to SQL Injection via the 'id' parameter in all versions up to, and including, 1.0.4 due to insufficient escaping on the user supplied param…","description":"The Team Circle Image Slider With Lightbox plugin for WordPress is vulnerable to SQL Injection via the 'id' parameter in all versions up to, and including, 1.0.4 due to insufficient escaping on the user supplied parameter and lack of sufficient preparation on the existing SQL query.  This makes it possible for authenticated attackers, with Administrator-level access and above, to append additional SQL queries into already existing queries that can be used to extract sensitive information from the database.","published":"2025-04-08T07:01:03.026Z","lastModified":"2026-04-08T17:18:55.707Z","withdrawn":null,"severity":{"overall":"MEDIUM","cvss":4.9},"cvss":{"v2":null,"v3_0":null,"v3_1":{"vectorString":"CVSS:3.1/AV:N/AC:L/PR:H/UI:N/S:U/C:H/I:N/A:N","baseScore":4.9,"baseSeverity":"MEDIUM","exploitabilityScore":null,"impactScore":null,"source":"cve.org"},"v4_0":null},"cwe":[{"cweId":"CWE-89","name":"CWE-89 Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')","source":"cve.org"}],"affected":[{"vendor":"nik00726","product":"Team Circle Image Slider With Lightbox","cpe":null,"versions":[{"version":null,"status":"affected","versionEndExcluding":null,"versionEndIncluding":"1.0.4"}],"platforms":[]}],"configurations":[],"references":[{"url":"https://www.wordfence.com/threat-intel/vulnerabilities/id/bd3e30ea-8f58-4895-b78c-fb18c94d5253?source=cve","source":"cve.org","tags":[]},{"url":"https://wordpress.org/plugins/circle-image-slider-with-lightbox/","source":"cve.org","tags":[]},{"url":"https://plugins.trac.wordpress.org/changeset?sfp_email=&sfph_mail=&reponame=&old=2061993%40circle-image-slider-with-lightbox&new=2061993%40circle-image-slider-with