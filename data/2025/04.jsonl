{"schemaVersion":1,"id":"CVE-2003-20001","state":"PUBLISHED","summary":"An issue was discovered on Mitel ICP VoIP 3100 devices. When a remote user attempts to log in via TELNET during the login wait time and an external call comes in, the system incorrectly divulges information about the…","description":"An issue was discovered on Mitel ICP VoIP 3100 devices. When a remote user attempts to log in via TELNET during the login wait time and an external call comes in, the system incorrectly divulges information about the call and any SMDR records generated by the system. The information provided includes the service type, extension number and other parameters, related to the call activity.","published":"2025-04-01T00:00:00.000Z","lastModified":"2025-04-04T20:22:13.607Z","withdrawn":null,"severity":{"overall":"MEDIUM","cvss":5.6},"cvss":{"v2":null,"v3_0":null,"v3_1":{"vectorString":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:L/I:L/A:L","baseScore":5.6,"baseSeverity":"MEDIUM","exploitabilityScore":null,"impactScore":null,"source":"cve.org"},"v4_0":null},"cwe":[{"cweId":"CWE-200","name":"CWE-200 Exposure of Sensitive Information to an Unauthorized Actor","source":"cve.org"}],"affected":[{"vendor":"n/a","product":"n/a","cpe":null,"versions":[{"version":"n/a","status":"affected","versionEndExcluding":null,"versionEndIncluding":null}],"platforms":[]}],"configurations":[],"references":[{"url":"https://packetstorm.news/files/id/31445","source":"cve.org","tags":[]},{"url":"http://olografix.org/acme/mitel.txt","source":"cve.org","tags":[]},{"url":"https://rb.gy/1smt22","source":"cve.org","tags":[]},{"url":"https://www.exploit-db.com/exploits/49176","source":"cve.org","tags":[]}],"exploit":null,"credits":[],"sources":["cve.org"],"primarySource":"cve.org"}
