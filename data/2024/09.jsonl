{"schemaVersion":1,"id":"CVE-2019-25212","state":"PUBLISHED","summary":"The video carousel slider with lightbox plugin for WordPress is vulnerable to SQL Injection via the 'id' parameter in all versions up to, and including, 1.0.6 due to insufficient escaping on the user supplied paramete…","description":"The video carousel slider with lightbox plugin for WordPress is vulnerable to SQL Injection via the 'id' parameter in all versions up to, and including, 1.0.6 due to insufficient escaping on the user supplied parameter and lack of sufficient preparation on the existing SQL query.  This makes it possible for authenticated attackers, with administrator-level access and above, to append additional SQL queries into already existing queries that can be used to extract sensitive information from the database.","published":"2024-09-11T08:31:04.386Z","lastModified":"2026-04-08T17:04:40.750Z","withdrawn":null,"severity":{"overall":"MEDIUM","cvss":4.9},"cvss":{"v2":null,"v3_0":null,"v3_1":{"vectorString":"CVSS:3.1/AV:N/AC:L/PR:H/UI:N/S:U/C:H/I:N/A:N","baseScore":4.9,"baseSeverity":"MEDIUM","exploitabilityScore":null,"impactScore":null,"source":"cve.org"},"v4_0":null},"cwe":[{"cweId":"CWE-89","name":"CWE-89 Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')","source":"cve.org"}],"affected":[{"vendor":"nik00726","product":"video carousel slider with lightbox","cpe":null,"versions":[{"version":null,"status":"affected","versionEndExcluding":null,"versionEndIncluding":"1.0.6"}],"platforms":[]},{"vendor":"i13websolution","product":"video_carousel_slider_with_lightbox","cpe":"cpe:2.3:a:i13websolution:video_carousel_slider_with_lightbox:*:*:*:*:*:wordpress:*:*","versions":[{"version":null,"status":"affected","versionEndExcluding":null,"versionEndIncluding":"1.0.6"}],"platforms":[]}],"configurations":[],"references":[{"url":"https://www.wordfence.com/threat-intel/vulnerabilities/id/85e70be3-3ed7-4ce1-a20c-046fb7c4ec31?source=cve","source":"cve.org","