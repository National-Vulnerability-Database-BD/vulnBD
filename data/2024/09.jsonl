{"schemaVersion":1,"id":"CVE-2020-36830","state":"PUBLISHED","summary":"A vulnerability was found in nescalante urlregex up to 0.5.0 and classified as problematic. This issue affects some unknown processing of the file index.js of the component Backtracking. The manipulation leads to inef…","description":"A vulnerability was found in nescalante urlregex up to 0.5.0 and classified as problematic. This issue affects some unknown processing of the file index.js of the component Backtracking. The manipulation leads to inefficient regular expression complexity. The attack may be initiated remotely. The exploit has been disclosed to the public and may be used. Upgrading to version 0.5.1 is able to address this issue. The identifier of the patch is e5a085afe6abfaea1d1a78f54c45af9ef43ca1f9. It is recommended to upgrade the affected component.","published":"2024-09-02T16:00:05.813Z","lastModified":"2024-09-03T14:21:44.280Z","withdrawn":null,"severity":{"overall":"MEDIUM","cvss":5.3},"cvss":{"v2":{"vectorString":"AV:N/AC:L/Au:S/C:N/I:N/A:P","baseScore":4,"baseSeverity":"MEDIUM","exploitabilityScore":null,"impactScore":null,"source":"cve.org"},"v3_0":{"vectorString":"CVSS:3.0/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:N/A:L","baseScore":4.3,"baseSeverity":"MEDIUM","exploitabilityScore":null,"impactScore":null,"source":"cve.org"},"v3_1":{"vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:N/A:L","baseScore":4.3,"baseSeverity":"MEDIUM","exploitabilityScore":null,"impactScore":null,"source":"cve.org"},"v4_0":{"vectorString":"CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:N/VI:N/VA:L/SC:N/SI:N/SA:N","baseScore":5.3,"baseSeverity":"MEDIUM","exploitabilityScore":null,"impactScore":null,"source":"cve.org"}},"cwe":[{"cweId":"CWE-1333","name":"CWE-1333 Inefficient Regular Expression Complexity","source":"cve.org"}],"affected":[{"vendor":"nescalante","product":"urlregex","cpe":null,"versions":[{"version":"0.1","status":"affected","versionEndExcluding":null,"versionEndIncluding":null},{"version":"0.2","stat