---
import { siteConfig } from "../../config/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-border">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
    <div class="grid gap-8 md:grid-cols-4">
      <div class="md:col-span-2">
        <p class="font-mono text-sm font-semibold">{siteConfig.name}</p>
        <p class="mt-2 max-w-sm text-sm text-muted">{siteConfig.description}</p>
      </div>
      <div>
        <p class="font-mono text-xs uppercase tracking-wide text-muted">Data</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href={`${siteConfig.basePath}/downloads`} class="hover:text-accent">Downloads</a></li>
          <li><a href={`${siteConfig.basePath}/statistics`} class="hover:text-accent">Statistics</a></li>
        </ul>
      </div>
      <div>
        <p class="font-mono text-xs uppercase tracking-wide text-muted">About</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href={`${siteConfig.basePath}/about`} class="hover:text-accent">About &amp; attribution</a></li>
          <li><a href={siteConfig.issuesUrl} class="hover:text-accent" rel="noopener noreferrer">Report an issue</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-8 flex flex-col gap-2 border-t border-border pt-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {siteConfig.name}. CVE data sourced from the CVE Program and redistributed per its terms — see About for full attribution.</p>
      <p>Not affiliated with MITRE, the CVE Program, or NVD.</p>
    </div>
  </div>
</footer>
