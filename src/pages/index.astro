---
import Layout from "../layouts/Layout.astro";
import CveRow from "../components/CveRow.astro";
import { siteConfig } from "../../config/site";
import { getCveIndex, getMetadata, getStatistics } from "../lib/data";
import { formatDateTime } from "../lib/severity";

const index = getCveIndex();
const stats = getStatistics();
const metadata = getMetadata();

const recentIds = stats.recentlyAdded.slice(0, 6);
const criticalIds = Object.entries(index)
  .filter(([, e]) => e.severity === "CRITICAL")
  .sort((a, b) => (b[1].published ?? "").localeCompare(a[1].published ?? ""))
  .slice(0, 6)
  .map(([id]) => id);

const totalFormatted = new Intl.NumberFormat("en-US").format(stats.totalCves);
---

<Layout title={siteConfig.name} description={siteConfig.description}>
  <section class="border-b border-border">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24">
      <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-accent">
        <span class="relative inline-block h-3 w-5 shrink-0 border border-border" aria-hidden="true">
          <span class="absolute inset-0 bg-[#006a4e]"></span>
          <span class="absolute left-1/2 top-1/2 h-2 w-2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#f42a41]"></span>
        </span>
        Bangladesh · National Vulnerability Database
      </p>
      <h1 class="mt-4 max-w-3xl font-serif text-4xl font-semibold tracking-tight sm:text-5xl">
        Bangladesh's national <span class="text-accent">vulnerability database</span>.
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-muted">
        {siteConfig.description} Every record traces back to its source, and every update is tracked.
      </p>

      <form action={`${siteConfig.basePath}/search`} method="get" class="mt-8 max-w-2xl">
        <label class="sr-only" for="hero-search">Search CVEs</label>
        <div class="relative">
          <input
            id="hero-search"
            name="q"
            type="search"
            placeholder="Search CVE ID, vendor, product, or CWE…"
            class="w-full border border-border bg-surface px-4 py-3.5 pl-11 font-mono text-sm text-text placeholder:text-muted focus:border-accent"
          />
          <svg class="pointer-events-none absolute left-3.5 top-4 h-5 w-5 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>
          <button type="submit" class="absolute right-1.5 top-1.5 border border-border bg-background px-4 py-2 font-mono text-xs uppercase tracking-wide hover:border-accent">
            Search
          </button>
        </div>
      </form>

      <dl class="mt-12 grid grid-cols-2 gap-6 sm:grid-cols-4">
        <div>
          <dt class="font-mono text-xs uppercase tracking-wide text-muted">Total CVEs</dt>
          <dd class="mt-1 font-mono text-3xl font-semibold">{totalFormatted}+</dd>
        </div>
        <div>
          <dt class="font-mono text-xs uppercase tracking-wide text-muted">Critical</dt>
          <dd class="mt-1 font-mono text-3xl font-semibold text-critical">{stats.bySeverity.CRITICAL ?? 0}</dd>
        </div>
        <div>
          <dt class="font-mono text-xs uppercase tracking-wide text-muted">High</dt>
          <dd class="mt-1 font-mono text-3xl font-semibold text-high">{stats.bySeverity.HIGH ?? 0}</dd>
        </div>
        <div>
          <dt class="font-mono text-xs uppercase tracking-wide text-muted">Database updated</dt>
          <dd class="mt-1 font-mono text-sm text-text" title={formatDateTime(metadata.lastUpdate)}>{formatDateTime(metadata.lastUpdate)}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <div class="flex items-center justify-between">
          <h2 class="font-mono text-sm uppercase tracking-wide text-muted">Recently added</h2>
          <a href={`${siteConfig.basePath}/cves?sort=newest`} class="text-sm text-accent hover:underline">View all →</a>
        </div>
        <div class="mt-4 space-y-3">
          {recentIds.map((id) => {
            const e = index[id];
            return e ? <CveRow id={id} severity={e.severity} cvss={e.cvss} summary={e.summary} published={e.published} lastModified={e.lastModified} /> : null;
          })}
        </div>
      </div>

      <div>
        <div class="flex items-center justify-between">
          <h2 class="font-mono text-sm uppercase tracking-wide text-muted">Critical vulnerabilities</h2>
          <a href={`${siteConfig.basePath}/cves?severity=CRITICAL`} class="text-sm text-accent hover:underline">View all →</a>
        </div>
        <div class="mt-4 space-y-3">
          {criticalIds.map((id) => {
            const e = index[id];
            return e ? <CveRow id={id} severity={e.severity} cvss={e.cvss} summary={e.summary} published={e.published} lastModified={e.lastModified} /> : null;
          })}
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-surface/40">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h2 class="text-lg font-semibold">Where this data comes from</h2>
          <p class="mt-1 max-w-xl text-sm text-muted">
            Normalized from the CVE Program's official records, with optional CISA KEV enrichment. Every field keeps its source attribution — see the About page for full details.
          </p>
        </div>
        <a href={`${siteConfig.basePath}/about`} class="shrink-0 border border-border px-4 py-2 font-mono text-xs uppercase tracking-wide hover:border-accent">
          Data sources & licensing
        </a>
      </div>
    </div>
  </section>
</Layout>
