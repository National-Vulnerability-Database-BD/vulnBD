---
import Layout from "../../layouts/Layout.astro";
import CveRow from "../../components/CveRow.astro";
import BarChart from "../../components/BarChart.astro";
import { siteConfig } from "../../../config/site";
import { getCveIndex, getYearIndex } from "../../lib/data";

export async function getStaticPaths() {
  const years = getYearIndex();
  return Object.keys(years).map((year) => ({ params: { year } }));
}

const { year } = Astro.params;
const yearNum = Number(year);
const index = getCveIndex();

const entries = Object.entries(index).filter(([, e]) => e.year === yearNum);
const published = entries.filter(([, e]) => e.state === "PUBLISHED");

const monthCounts = new Map<number, number>();
for (const [, e] of entries) monthCounts.set(e.month, (monthCounts.get(e.month) ?? 0) + 1);
const monthBars = Array.from({ length: 12 }, (_, i) => ({
  label: new Date(2000, i, 1).toLocaleString("en-US", { month: "short" }),
  value: monthCounts.get(i + 1) ?? 0,
}));

const severityCounts = new Map<string, number>();
for (const [, e] of published) severityCounts.set(e.severity, (severityCounts.get(e.severity) ?? 0) + 1);
const severityColors: Record<string, string> = {
  CRITICAL: "var(--color-critical)",
  HIGH: "var(--color-high)",
  MEDIUM: "var(--color-medium)",
  LOW: "var(--color-low)",
};
const severityBars = ["CRITICAL", "HIGH", "MEDIUM", "LOW"].map((s) => ({ label: s, value: severityCounts.get(s) ?? 0, color: severityColors[s] }));

const recent = [...published].sort((a, b) => (b[1].published ?? "").localeCompare(a[1].published ?? "")).slice(0, 12);
---

<Layout title={`CVEs published in ${year}`} description={`${entries.length} CVE records from ${year}.`} canonicalPath={`/year/${year}`}>
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <h1 class="font-mono text-2xl font-semibold">{year}</h1>
    <p class="mt-1 text-sm text-muted">{new Intl.NumberFormat("en-US").format(entries.length)} record{entries.length === 1 ? "" : "s"} filed this year.</p>

    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      <div class="border border-border bg-surface p-5">
        <h2 class="font-mono text-xs uppercase tracking-wide text-muted">Monthly breakdown</h2>
        <div class="mt-4"><BarChart bars={monthBars} /></div>
      </div>
      <div class="border border-border bg-surface p-5">
        <h2 class="font-mono text-xs uppercase tracking-wide text-muted">Severity distribution</h2>
        <div class="mt-4"><BarChart bars={severityBars} /></div>
      </div>
    </div>

    <div class="mt-8 flex items-center justify-between">
      <h2 class="font-mono text-sm uppercase tracking-wide text-muted">Recent CVEs from {year}</h2>
      <a href={`${siteConfig.basePath}/cves?year=${year}`} class="text-sm text-accent hover:underline">Browse all →</a>
    </div>
    <div class="mt-4 space-y-3">
      {recent.map(([id, e]) => (
        <CveRow id={id} severity={e.severity} cvss={e.cvss} summary={e.summary} published={e.published} lastModified={e.lastModified} />
      ))}
    </div>
  </div>
</Layout>
